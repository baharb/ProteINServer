# Copy this to .env and fill in your values
GROQ_API_KEY=your_groq_key_here
PORT=3000

# Supabase project (same values as the app's src/lib/supabase.js).
# Used to check that requests come from signed-in users.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional: override AI models if Groq retires one
# CHAT_MODEL=openai/gpt-oss-20b
# ESTIMATE_MODEL=openai/gpt-oss-20b
# SCAN_MODEL=qwen/qwen3.8-27b

# Free version: total AI calls per day for the whole server (keeps you inside Groq's free tier)
# SERVER_DAILY_BUDGET=900
